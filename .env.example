# ── Required ─────────────────────────────────────────────────────────────────
# Public URL of the site, no trailing slash. The Plex sign-in callback and Tautulli webhook URL are built from it.
PUBLIC_URL=https://plex.example.com
# Long random string: signs sessions and encrypts stored secrets (Plex owner token, Tautulli and Stripe keys).
# Keep it secret and don't change it (stored secrets become unreadable).  Generate: openssl rand -base64 48
SECRET_KEY=
# Database password used by docker-compose.yml
POSTGRES_PASSWORD=

# ── First admin ──────────────────────────────────────────────────────────────
# Comma-separated Plex usernames and/or Plex account ids that become admins when they sign in.
# (Not emails: Plex doesn't guarantee an account's email was confirmed.) The server owner also becomes
# an admin automatically once the owner account is connected.
BOOTSTRAP_ADMINS=

# Host port for docker-compose.yml
PTM_PORT=8000
