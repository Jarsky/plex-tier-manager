# Copy this file to .env and set your real values before running the stack.

# Security
SECRET_KEY=replace-with-a-long-random-secret

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Optional admin bootstrap assignment during signup
ADMIN_EMAIL=admin@example.com

# Database
DATABASE_URL=sqlite:///app.db

# Integrations (managed in Admin UI after initial setup)
PLEX_TOKEN=
PLEX_CLIENT_ID=
PLEX_REDIRECT_URI=
TAUTULLI_API_KEY=
TAUTULLI_URL=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Optional helper script values
ADMIN_PASSWORD=
